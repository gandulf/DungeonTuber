{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dungeontuber-server",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "server",
        "--port",
        "8765",
        "--fake-lights"
      ],
      "port": 8765
    },
    {
      "name": "dungeontuber-web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}