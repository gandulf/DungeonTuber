[flake8]
extend-ignore = E203
exclude = .github,.venv,.git,__pycache__,build,dist

# Count the number of occurrences of each error
count = True

# Correctness checks only: syntax errors, pyflakes (F), comparison/membership pitfalls, deprecations.
# Pure style (E1-E5, W1-W5) is intentionally not enforced yet.
select = E9,F,E703,E711,E712,E713,E714,E721,E722,E731,W6

# Define "_" as a builtin (useful for internationalization/gettext)
builtins = _

# Show the source code line where the error occurred
show-source = True

# Print total count of each error at the end
statistics = True